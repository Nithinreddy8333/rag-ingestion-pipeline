# Everything is optional: with no settings the project runs offline with an embedded
# Qdrant and the hashing embedder.

DOCS_DIR=data/docs
# Leave empty to use the embedded on-disk Qdrant in state/qdrant.
QDRANT_URL=

# hashing | openai | local
EMBED_PROVIDER=hashing
# hashing: vector size (default 512). openai / local: the model name.
EMBED_MODEL=
OPENAI_API_KEY=

# heading | fixed
CHUNKER=heading
CHUNK_MAX_TOKENS=180
CHUNK_OVERLAP_TOKENS=30
REDACT_PII=1
